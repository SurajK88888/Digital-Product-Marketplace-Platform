{
  "name": "digital-product-marketplace",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-grade digital product marketplace platform — monorepo root.",
  "workspaces": [
    "apps/frontend",
    "packages/shared-types",
    "packages/shared-utils",
    "packages/design-system"
  ],
  "scripts": {
    "dev:frontend": "npm --workspace=apps/frontend run dev",
    "build:frontend": "npm --workspace=apps/frontend run build",
    "lint": "npm --workspace=apps/frontend run lint",
    "lint:fix": "npm --workspace=apps/frontend run lint:fix",
    "type-check": "npm --workspace=apps/frontend run type-check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "husky": "^9.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
