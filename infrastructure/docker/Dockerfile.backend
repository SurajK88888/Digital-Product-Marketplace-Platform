# =============================================================
# Dockerfile.backend — Multi-Stage FastAPI Production Build
# Uses Python 3.12 slim base with non-root system user
# =============================================================

# ── Stage 1: Build Dependencies (compile wheels) ──────────────
FROM python:3.12-slim AS builder
LABEL stage="builder"

# Install build tools required for native extensions (e.g., asyncpg, cryptography)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy dependency manifests first (Docker layer cache optimization)
COPY apps/backend/requirements.txt .

# Build wheel packages for all dependencies
RUN pip install --upgrade pip wheel \
 && pip wheel --no-cache-dir --wheel-dir /build/wheels -r requirements.txt

# ── Stage 2: Production Runtime ────────────────────────────────
FROM python:3.12-slim AS runner
LABEL stage="runner"

# Install only runtime OS dependencies (no build tools in production)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
 && rm -rf /var/lib/apt/lists/*

# Create non-root system user (never run as root in production)
RUN groupadd --system --gid 1001 appgroup \
 && useradd --system --uid 1001 --gid appgroup --no-create-home appuser

WORKDIR /app

# Install pre-built wheels (no internet access required in production)
COPY --from=builder /build/wheels /wheels
RUN pip install --no-cache-dir --no-index --find-links /wheels /wheels/* \
 && rm -rf /wheels

# Copy application source
COPY apps/backend/ .

# Set ownership and switch to non-root user
RUN chown -R appuser:appgroup /app
USER appuser

# Environment
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    PORT=8000

EXPOSE 8000

# Health check using the liveness endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:8000/api/v1/health/live || exit 1

# Start uvicorn with production settings (no --reload)
CMD ["uvicorn", "main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "1", \
     "--log-config", "/dev/null"]
