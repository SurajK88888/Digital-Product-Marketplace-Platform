# =============================================================
# Digital Product Marketplace Platform — .gitignore
# Covers: Node.js, Python, Next.js, Docker, OS artifacts
# =============================================================

# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# Python virtual environments
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
*.whl

# ── Environment & Secrets (NEVER commit these) ────────────────
.env
.env.*
!.env.example
!.env.*.example

# ── Build Artifacts ───────────────────────────────────────────
# Next.js
.next/
out/
.vercel/

# TypeScript
*.tsbuildinfo

# ── Test & Coverage ───────────────────────────────────────────
coverage/
.nyc_output/
.pytest_cache/
htmlcov/
*.cover
.hypothesis/

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids/
*.pid
*.seed

# ── Editor & OS Artifacts ──────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Docker ────────────────────────────────────────────────────
# (Docker files themselves are committed — only runtime artifacts ignored)
docker-data/

# ── Misc ──────────────────────────────────────────────────────
.turbo/
.eslintcache
.parcel-cache
