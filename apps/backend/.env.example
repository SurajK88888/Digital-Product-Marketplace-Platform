# =============================================================
# Backend Environment Template (.env.example)
# Copy to .env and fill in real values. NEVER commit .env
# =============================================================

# ── Application ───────────────────────────────────────────────
APP_NAME="Digital Product Marketplace API"
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# ── Database (PostgreSQL with asyncpg) ────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/marketplace_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO_SQL=false

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security & JWT ────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=change-me-use-a-128-char-random-hex-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── AWS Storage ───────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=marketplace-product-vault
DOWNLOAD_URL_EXPIRY_SECONDS=300

# ── Email (AWS SES / SMTP) ────────────────────────────────────
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=noreply@marketplace.com

# ── OAuth (Google) ────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ── OAuth (GitHub) ────────────────────────────────────────────
GITHUB_CLIENT_ID=your-github-app-client-id
GITHUB_CLIENT_SECRET=your-github-app-client-secret

# ── Stripe ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ── Sentry ────────────────────────────────────────────────────
SENTRY_DSN=https://your-key@sentry.io/your-project-id

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
